<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_CustomEventLogger" Id="{98ccbd73-35b4-43e4-a7b3-ba2b69e0d9d3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CustomEventLogger
VAR CONSTANT
    iArraySize : INT := 20;
END_VAR
VAR
	//Event logger message instances
    fbEventError : FB_TcMessage;
    fbEventWarning : FB_TcMessage;
    fbEventInfo : FB_TcMessage;	

    // Event array
	astEventBuffer : ARRAY[0..iArraySize - 1] OF ST_EventMessage;
    iBufferWriteIndex : INT := 0;
    iBufferReadIndex : INT := 0;
    iEventCount : INT := 0;
	
    // Event status
	bErrorInitialised : BOOL := FALSE;
	bWarningInitialised : BOOL := FALSE;
	bInfoInitialised : BOOL := FALSE;
    hrErrorEventCreateStatus : HRESULT;
    hrErrorEventSendStatus : HRESULT;
	hrWarningEventCreateStatus : HRESULT;
    hrWarningEventSendStatus : HRESULT;
	hrInfoEventCreateStatus : HRESULT;
    hrInfoEventSendStatus : HRESULT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bErrorInitialised THEN
    hrErrorEventCreateStatus := fbEventError.CreateEx(TC_EVENTS.PLC_Messages.Error, 0);
    bErrorInitialised := hrErrorEventCreateStatus = 0;
END_IF

IF NOT bWarningInitialised THEN
    hrWarningEventCreateStatus := fbEventWarning.CreateEx(TC_EVENTS.PLC_Messages.Warning, 0);
    bWarningInitialised := hrWarningEventCreateStatus = 0;
END_IF

IF NOT bInfoInitialised THEN
    hrInfoEventCreateStatus := fbEventInfo.CreateEx(TC_EVENTS.PLC_Messages.Info, 0);
    bInfoInitialised := hrInfoEventCreateStatus = 0;
END_IF

IF bErrorInitialised AND bWarningInitialised AND bInfoInitialised AND iEventCount >0 THEN
    WriteMessage();
END_IF
]]></ST>
    </Implementation>
    <Method Name="LogError" Id="{7f15a9b0-2928-4ca0-9048-a4f939d50ece}">
      <Declaration><![CDATA[METHOD PUBLIC LogError : BOOL
VAR_INPUT
	sEventError : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LogError := FALSE;

IF iEventCount < iArraySize THEN
    astEventBuffer[iBufferWriteIndex].sMessage := sEventError;
    astEventBuffer[iBufferWriteIndex].eSeverity := E_EventSeverity.Error;

    iBufferWriteIndex := iBufferWriteIndex + 1;

    IF iBufferWriteIndex >= iArraySize THEN
    	iBufferWriteIndex := 0;
	END_IF
	
    iEventCount := iEventCount + 1;
    LogError := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogInfo" Id="{9b6e75ef-d311-4b05-ae03-efe708c54118}">
      <Declaration><![CDATA[METHOD LogInfo : BOOL
VAR_INPUT
	sEventInfo : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LogInfo := FALSE;

IF iEventCount < iArraySize THEN
    astEventBuffer[iBufferWriteIndex].sMessage := sEventInfo;
    astEventBuffer[iBufferWriteIndex].eSeverity := E_EventSeverity.Info;

    iBufferWriteIndex := iBufferWriteIndex + 1;

    IF iBufferWriteIndex >= iArraySize THEN
        iBufferWriteIndex := 0;
    END_IF

    iEventCount := iEventCount + 1;
    LogInfo := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogWarning" Id="{73d3faa0-c269-4999-a745-b5531a23e5d8}">
      <Declaration><![CDATA[METHOD LogWarning : BOOL
VAR_INPUT
	sEventWarning : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LogWarning := FALSE;

IF iEventCount < iArraySize THEN
    astEventBuffer[iBufferWriteIndex].sMessage := sEventWarning;
    astEventBuffer[iBufferWriteIndex].eSeverity := E_EventSeverity.Warning;

    iBufferWriteIndex := iBufferWriteIndex + 1;

    IF iBufferWriteIndex >= iArraySize THEN
        iBufferWriteIndex := 0;
    END_IF

    iEventCount := iEventCount + 1;
    LogWarning := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteMessage" Id="{91c1e5fb-f28b-4d9e-9265-592aa951f876}">
      <Declaration><![CDATA[METHOD WriteMessage : BOOL
VAR
	sEventMessage : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[WriteMessage := FALSE;

sEventMessage := astEventBuffer[iBufferReadIndex].sMessage;

CASE astEventBuffer[iBufferReadIndex].eSeverity OF

    E_EventSeverity.Error:
        IF bErrorInitialised THEN
            fbEventError.ipArguments.Clear().AddString(sEventMessage);
            hrErrorEventSendStatus := fbEventError.Send(0);
            WriteMessage := hrErrorEventSendStatus = 0;
        END_IF

    E_EventSeverity.Warning:
        IF bWarningInitialised THEN
            fbEventWarning.ipArguments.Clear().AddString(sEventMessage);
            hrWarningEventSendStatus := fbEventWarning.Send(0);
            WriteMessage := hrWarningEventSendStatus = 0;
        END_IF

    E_EventSeverity.Info:
        IF bInfoInitialised THEN
            fbEventInfo.ipArguments.Clear().AddString(sEventMessage);
            hrInfoEventSendStatus := fbEventInfo.Send(0);
            WriteMessage := hrInfoEventSendStatus = 0;
        END_IF

END_CASE

IF WriteMessage THEN
    iBufferReadIndex := iBufferReadIndex + 1;
	IF iBufferReadIndex >= iArraySize THEN
		iBufferReadIndex := 0;
	END_IF
    iEventCount := iEventCount - 1;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>